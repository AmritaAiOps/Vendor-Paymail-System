# Copy to .env and fill in. Never commit .env.

# --- A ---
DATABASE_URL=sqlite:///./dev.db
POSTGRES_PASSWORD=change-me
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Sudhamayi Enterprises Pvt. Ltd.
SMTP_STARTTLS=true
# DRY_RUN=true renders and logs every email but sends nothing. It is the default; set false only to send for real.
DRY_RUN=true
# Redirect every email to one test inbox (leave empty in production)
TEST_RECIPIENT=
# Per uploaded file. Nginx caps request bodies to match (deploy/nginx.conf): change both together.
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO
# Port Nginx publishes in docker-compose.prod.yml
HTTP_PORT=80
# Firebase login. Project ID from the Firebase console; no service account needed.
FIREBASE_PROJECT_ID=
# Anyone with a verified email at this domain (no "@") can sign in as a viewer
ALLOWED_EMAIL_DOMAIN=
# Comma-separated admin emails: can run the send job now, rebuild the history file and change settings
ADMIN_EMAILS=

# --- B ---
HISTORY_XLSX_PATH=./data/email_history.xlsx
# Firebase web app config (public, not secret); baked into the frontend at build time
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
