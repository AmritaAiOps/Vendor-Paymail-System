# Copy to .env and fill in. Never commit .env.

# --- A ---
DATABASE_URL=sqlite:///./dev.db
POSTGRES_PASSWORD=change-me
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Sudhamayi Enterprises Pvt. Ltd.
SMTP_STARTTLS=true
# DRY_RUN=true renders and logs every email but sends nothing. It is the default; set false only to send for real.
DRY_RUN=true
# Redirect every email to one test inbox (leave empty in production)
TEST_RECIPIENT=

# --- B ---
HISTORY_XLSX_PATH=./data/email_history.xlsx
